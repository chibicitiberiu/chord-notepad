[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
pyfluidsynth = ">=1.4.0"
pychord = "*"
music21 = "*"
mido = "*"
# The window. 6.12 is the last Qt for Windows 10; its macOS floor is 14.4
# (chord-notepad.spec).
pyside6-essentials = "==6.12.*"

[dev-packages]
pytest = "~=7.4.0"
hypothesis = "*"
pyinstaller = "*"
macholib = "*"  # PyInstaller dependency for macOS (included on all platforms for lock consistency)
pefile = "*"  # PyInstaller dependency for Windows (included on all platforms for lock consistency)
colorama = "*"  # Sphinx dependency for Windows (included on all platforms for lock consistency)
pywin32-ctypes = "*"  # PyInstaller dependency for Windows (included on all platforms for lock consistency)
sphinx = "*"
sphinx_rtd_theme = "*"
rinohtype = "*"
pytest-qt = "*"
# CI's icon check and the help screenshot tool (packaging/tools); the app
# doesn't use it (the PyInstaller spec excludes PIL).
pillow = "*"

[requires]
python_version = "3.14"
