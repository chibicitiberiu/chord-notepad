<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Debug builds only: the chord sheet on its own, with the sample song
         loaded, for emulator checks over adb (ChordSheetDebugActivity). -->
    <application>
        <!-- Debug builds only: fakes the dates (and the billing answer) the
             support prompt is decided from, for emulator checks
             (DebugLaunchOverride). -->
        <provider
            android:name=".debug.DebugLaunchOverrideProvider"
            android:authorities="${applicationId}.debuglaunch"
            android:exported="false" />
        <activity
            android:name=".ui.chordsheet.ChordSheetDebugActivity"
            android:exported="true" />
        <!-- Debug builds only: the main screen set up from a scene, for the
             user guide's screenshots (android/tools/help_screenshots.py). -->
        <!-- Debug builds only: the support card and dialogs over a fake billing
             state, for emulator screenshots (SupportDebugActivity). -->
        <activity
            android:name=".ui.support.SupportDebugActivity"
            android:exported="true" />
        <activity
            android:name=".helpshot.HelpShotActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
