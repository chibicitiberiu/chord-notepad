# Android toolchain paths. Copy to android/local.env (gitignored), adjust, then:
#   source android/local.env
# Everything lives outside ~ (the home partition is small).
export ANDROID_ROOT=/mnt/data_linux/Bin/android
export ANDROID_HOME=$ANDROID_ROOT/sdk
export ANDROID_SDK_ROOT=$ANDROID_HOME
export ANDROID_AVD_HOME=$ANDROID_ROOT/avd
export ANDROID_USER_HOME=$ANDROID_ROOT/user
export ANDROID_EMULATOR_HOME=$ANDROID_USER_HOME
export GRADLE_USER_HOME=$ANDROID_ROOT/gradle
export PIP_CACHE_DIR=$ANDROID_ROOT/pip-cache
export JAVA_HOME=$ANDROID_ROOT/jdk/jdk-21.0.13+9
# Kotlin/Native and Maven would otherwise default to ~ (not used today; belt and braces)
export KONAN_DATA_DIR=$ANDROID_ROOT/konan
export MAVEN_OPTS="-Dmaven.repo.local=$ANDROID_ROOT/m2"
# Chaquopy needs a host Python with the same major.minor as the app (3.14)
export CHAQUOPY_BUILD_PYTHON=/usr/bin/python3.14
# Downloads/prebuilts cache (FluidSynth prebuilt zip, upstream music21 wheel)
export CHORD_NOTEPAD_ANDROID_CACHE=$ANDROID_ROOT/cache
# Gradle build outputs (one subdirectory per checkout) instead of android/*/build
export CHORD_NOTEPAD_ANDROID_BUILD_ROOT=$ANDROID_ROOT/build
# Reproducible builds: with SOURCE_DATE_EPOCH set, the .pyc files that pip
# compiles are hash-based instead of embedding the build time (M2 finding).
# Pinned to the last commit's time; PYTHONHASHSEED keeps set ordering stable.
export SOURCE_DATE_EPOCH=$(git -C "$(dirname "${BASH_SOURCE[0]:-$0}")" log -1 --format=%ct 2>/dev/null || echo 1700000000)
export PYTHONHASHSEED=0
export PATH=$JAVA_HOME/bin:$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools:$ANDROID_HOME/emulator:$PATH
# The Android User Guide is built by Sphinx at build time: point this at a Python that has
# the desktop docs stack (the pipenv venv: `pipenv --venv`), or pip install -r
# android/docs-requirements.txt into CHAQUOPY_BUILD_PYTHON.
# export CHORD_NOTEPAD_DOCS_PYTHON=$HOME/.local/share/virtualenvs/chord-notepad-XXXX/bin/python
