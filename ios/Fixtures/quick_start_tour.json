          "message": "",
          "start": 85
         },
         {
          "end": 98,
          "kind": "chord",
          "message": "",
          "start": 95
         }
        ],
        "text": "Do        Lam       Rem7      Sol7\nSomewhere a melody is calling\nFa        Do/Mi     Rem       Sol\nEvery note is coming home"
       },
       {
        "image": null,
        "kind": "text",
        "notation": null,
        "spans": [],
        "text": "Roman numerals write chords relative to the key, set with {key: …} or the key in the song pill (Play tab). Change the key and the same song plays in the new key."
       },
       {
        "image": null,
        "kind": "snippet",
        "notation": "american",
