        ],
        "text": "{key: G}\nI         vi        IV        V7\nHere's a tune in any key you like\nii7       V7        I\nPlay it high or play it low"
       }
      ],
      "title": "Do-Re-Mi and Roman Numerals"
     },
     {
      "blocks": [
       {
        "image": null,
        "kind": "text",
        "notation": null,
        "spans": [],
        "text": "Directives in {braces} set the tempo, time signature and key. They can go anywhere, so a song can speed up or change key halfway through."
       },
       {
        "image": null,
        "kind": "snippet",
        "notation": "american",
        "spans": [
         {
          "end": 23,
